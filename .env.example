# ==============================================================================
#  Sức Khoẻ Giải Mã — environment template
#  Copy to .env.local and fill in. NEVER commit a filled copy.
#  Placeholders only in this file; CI fails the build if a real value appears.
# ==============================================================================

# ------------------------------------------------------------------------------
#  PUBLIC — safe to ship to the browser (NEXT_PUBLIC_ prefix)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_TURNSTILE_SITE_KEY
# Contact address shown on the site's contact page. Optional; falls back to empty.
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ------------------------------------------------------------------------------
#  SERVER ONLY — must never be prefixed NEXT_PUBLIC_ and never reach the client.
#  Set these in Vercel Project Settings > Environment Variables.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
RESEND_FROM_EMAIL="Suc Khoe Giai Ma <tin@example.com>"
RESEND_WEBHOOK_SECRET=REPLACE_WITH_RESEND_WEBHOOK_SECRET
TURNSTILE_SECRET_KEY=REPLACE_WITH_TURNSTILE_SECRET_KEY
REVALIDATE_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_STRING
# HMAC salt for consent IP hashing. A plain SHA-256 of an IP is brute-forceable,
# so consent records are HMAC'd with this secret instead.
IP_HASH_SALT=REPLACE_WITH_LONG_RANDOM_STRING
# HMAC key for signed newsletter unsubscribe tokens. The unsubscribe link is a
# deterministic HMAC of the subscriber id (the table stores only its hash), so this
# key must be stable in production. Falls back to IP_HASH_SALT if unset.
NEWSLETTER_TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ==============================================================================
#  SUPABASE EDGE FUNCTION SECRETS
#  These are NOT read by Next.js. Set them with:
#     npx supabase secrets set --env-file supabase/.env
#  (supabase/.env is gitignored.)
# ==============================================================================
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl
OPENROUTER_FALLBACK_MODEL=inclusionai/ling-3.0-flash
OPENROUTER_REFERER=https://example.com
YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_V3_KEY
YOUTUBE_CHANNEL_ID=UC79E6KatRfXbmdWVWGncsew
# Contact address sent as the User-Agent when polling Crossref/Europe PMC. Optional; without
# it the request goes through unauthenticated and may be rate-limited more aggressively.
RESEARCH_CONTACT_EMAIL=you@example.com
SITE_URL=https://example.com
AUTOMATION_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
ALERT_EMAIL=you@example.com

# ==============================================================================
#  NOT environment variables:
#  Operational behaviour (timezone, publish hour, window, thresholds, send caps,
#  require_approval, dry_run, paused) lives in internal.automation_settings so it
#  can be changed without a deploy. See the plan, section 2.
# ==============================================================================
