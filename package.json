{
  "name": "suc-khoe-giai-ma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node scripts/check-no-secrets.mjs",
    "check:env-example": "node scripts/check-env-example.mjs",
    "verify": "npm run check:env-example && npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:db:list": "node scripts/run-db-tests.mjs --list",
    "seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed-articles.ts",
    "seed:sql": "tsx --tsconfig tsconfig.scripts.json scripts/seed-articles.ts --sql",
    "ingest": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-youtube.ts",
    "generate": "tsx --tsconfig tsconfig.scripts.json scripts/generate-article.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@next/eslint-plugin-next": "^15.5.26",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
